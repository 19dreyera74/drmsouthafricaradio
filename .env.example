# Copy this file to .env.local and fill in your own keys.

# AI assistant — get a free Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Contact form email delivery
CONTACT_TO_EMAIL=info@drmsa.org

# Preferred: send through the drmsa.org mailbox on Afrihost (SSL on port 465).
# Set SMTP_PASS in Vercel (Settings → Environment Variables), never in this file.
SMTP_HOST=mail.drmsa.org
SMTP_PORT=465
SMTP_USER=info@drmsa.org
SMTP_PASS=

# Fallback when SMTP isn't set: a Resend API key from https://resend.com
RESEND_API_KEY=
CONTACT_FROM_EMAIL=DRM SA Website <onboarding@resend.dev>
